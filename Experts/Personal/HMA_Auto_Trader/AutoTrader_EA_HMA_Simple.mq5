#property version   "1.05"

#include <Arrays\ArrayObj.mqh>
#include <Trade\Trade.mqh>

//--- Enums
enum ENUM_ANCHOR_TYPE {
    ANCHOR_HMA_VALUE, 
    ANCHOR_CANDLE_HL  
};

enum ENUM_CHART_THEME {
    THEME_DARK,       
    THEME_LIGHT       
};

//--- Inputs
input string           InpSettings1           = "--- HMA Settings ---";
input int              InpHMAPeriod           = 14;               
input ENUM_APPLIED_PRICE InpPrice             = PRICE_CLOSE;      
input color            InpColor               = clrDodgerBlue;    

input string           InpSettings2           = "--- Anchor & Offset ---";
input ENUM_ANCHOR_TYPE InpAnchorType          = ANCHOR_HMA_VALUE; 
input int              InpOffsetPoints        = 0;                

input string           InpSettings3           = "--- Filters ---";
input int              InpMergeDistance       = 200;              
input int              InpSameDirDistance     = 400;              
input int              InpOppositeDirDistance = 800;              

input string           InpSettings4           = "--- State Machine ---";
input int              InpArmDistance         = 600;              
input int              InpConfirmDistance     = 400;              
input int              InpMaxFlips            = 2;                
input int              InpCleanupMinutes      = 60;               

input string           InpSettings5           = "--- Liquidity ---";
input int              InpLiqLookback         = 3;                

input string           InpSettings6           = "--- Entry Logic ---";
input bool             InpEnableBounce        = true;             // Rule 1: Bounce off Support/Resistance
input bool             InpEnableFakeout       = true;             // Rule 2: Fakeout / Failed Flip
input ulong            InpMagicNum            = 777777;           // EA Magic Number

input string           InpSettings7           = "--- Trade Management ---";
input double           InpLotSize             = 0.3;              // Initial Lot Size
input int              InpSL_Points           = 700;              // Stop Loss (Points)
input int              InpTP_Points           = 1400;             // Full Take Profit (Points)
input int              InpPartialsCount       = 7;                // Number of Partials
input double           InpPartialPct          = 10.0;             // % of Lot Size per Partial
input int              InpBE_Points           = 200;              // Points to trigger Break-Even
input int              InpTrailTrigger        = 1000;             // Points to trigger Trailing/TP Extension
input int              InpTrailExtendTP       = 2000;             // Extension Points (Added to Entry)
input int              InpTrailDistance       = 600;              // Trailing Stop Distance
input int              InpMaxTradesTotal      = 4;                // Max simultaneous trades globally
input int              InpMaxDDEntries        = 2;                // Max DD Entries per direction
input int              InpDDStepPoints        = 200;              // Distance between DD entries

input string           InpSettings8           = "--- Visuals & Toggles ---";
input bool             InpShowInflectionLines = true;             
input ENUM_LINE_STYLE  InpLineStyle           = STYLE_SOLID;      
input int              InpLineThickness       = 2;                
input bool             InpShowLiquidityLines  = true;             
input ENUM_CHART_THEME InpTheme               = THEME_DARK;       

//--- Global Variables
int hma_handle;
string Prefix;
bool isHistoricalInit = false;
datetime lastProcessedBar = 0;
CTrade trade;

//--- Trade Tracker Struct
struct PosTracker {
    ulong ticket;
    int partials_taken;
    bool tp_extended;
};
PosTracker trackerArray[];

//+------------------------------------------------------------------+
//| Chart Theme Application                                          |
//+------------------------------------------------------------------+
void SetChartTheme(ENUM_CHART_THEME theme) {
    ChartSetInteger(0, CHART_MODE, CHART_CANDLES);
    ChartSetInteger(0, CHART_SHOW_GRID, true); 
    
    if(theme == THEME_DARK) {
        ChartSetInteger(0, CHART_COLOR_BACKGROUND, clrBlack);
        ChartSetInteger(0, CHART_COLOR_FOREGROUND, clrSilver);
        ChartSetInteger(0, CHART_COLOR_GRID, (color)0x222222); 
    } else {
        ChartSetInteger(0, CHART_COLOR_BACKGROUND, clrWhite);
        ChartSetInteger(0, CHART_COLOR_FOREGROUND, clrBlack);
        ChartSetInteger(0, CHART_COLOR_GRID, clrLightGray);
    }
    ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| Tracker Array Functions                                          |
//+------------------------------------------------------------------+
int GetTrackerIndex(ulong ticket) {
    for(int i = 0; i < ArraySize(trackerArray); i++) {
        if(trackerArray[i].ticket == ticket) return i;
    }
    return -1;
}

int AddTracker(ulong ticket) {
    int size = ArraySize(trackerArray);
    ArrayResize(trackerArray, size + 1);
    trackerArray[size].ticket = ticket;
    trackerArray[size].partials_taken = 0;
    trackerArray[size].tp_extended = false;
    return size;
}

void CleanTracker() {
    for(int i = ArraySize(trackerArray) - 1; i >= 0; i--) {
        if(!PositionSelectByTicket(trackerArray[i].ticket)) {
            ArrayRemove(trackerArray, i, 1);
        }
    }
}

//+------------------------------------------------------------------+
//| CInflectionLine Class Definition                                 |
//+------------------------------------------------------------------+
class CInflectionLine : public CObject {
public:
    string         objName_Main;
    string         objName_Liq;
    string         objName_Label;

    double         rawPrice;
    double         linePrice;
    int            originalDir;    
    int            state;          
    int            pendingDir;
    bool           isPendingFlip;
    datetime       breakoutBar;
    bool           isArmed;
    int            flipCount;
    bool           isMitigated;
    datetime       mitigatedTime;
    double         liqPrice;
    datetime       startTime;
    bool           isMerged;

    CInflectionLine(string prefix, datetime time, double rPrice, double lPrice, int dir, double lqPrice) {
        static int counter = 0;
        counter++;
        
        objName_Main  = prefix + "_Main_" + IntegerToString(counter);
        objName_Liq   = prefix + "_Liq_" + IntegerToString(counter);
        objName_Label = prefix + "_Lbl_" + IntegerToString(counter);

        rawPrice      = rPrice;
        linePrice     = lPrice;
        originalDir   = dir;
        state         = 0;
        pendingDir    = 0;
        isPendingFlip = false;
        breakoutBar   = 0;
        isArmed       = false;
        flipCount     = 0;
        isMitigated   = false;
        mitigatedTime = 0;
        liqPrice      = lqPrice;
        startTime     = time;
        isMerged      = false;

        DrawObjects();
    }

    ~CInflectionLine() {
        ObjectDelete(0, objName_Main);
        ObjectDelete(0, objName_Liq);
        ObjectDelete(0, objName_Label);
    }

    void DrawObjects() {
        if(InpShowInflectionLines) {
            ObjectCreate(0, objName_Main, OBJ_TREND, 0, startTime, linePrice, startTime + PeriodSeconds(), linePrice);
            ObjectSetInteger(0, objName_Main, OBJPROP_RAY_RIGHT, true);
            ObjectSetInteger(0, objName_Main, OBJPROP_COLOR, clrGray);
            ObjectSetInteger(0, objName_Main, OBJPROP_STYLE, InpLineStyle);
            ObjectSetInteger(0, objName_Main, OBJPROP_WIDTH, InpLineThickness);
        }
        if(InpShowLiquidityLines) {
            ObjectCreate(0, objName_Liq, OBJ_TREND, 0, startTime, liqPrice, startTime + PeriodSeconds(), liqPrice);
            ObjectSetInteger(0, objName_Liq, OBJPROP_RAY_RIGHT, true);
            ObjectSetInteger(0, objName_Liq, OBJPROP_COLOR, clrDodgerBlue);
            ObjectSetInteger(0, objName_Liq, OBJPROP_STYLE, STYLE_DASH);
            ObjectSetInteger(0, objName_Liq, OBJPROP_WIDTH, 1);

            ObjectCreate(0, objName_Label, OBJ_TEXT, 0, startTime, liqPrice);
            ObjectSetString(0, objName_Label, OBJPROP_TEXT, " Liq");
            ObjectSetInteger(0, objName_Label, OBJPROP_COLOR, clrDodgerBlue);
            ObjectSetInteger(0, objName_Label, OBJPROP_ANCHOR, ANCHOR_LEFT);
        }
    }

    void UpdateVisuals() {
        if(isMitigated) {
            if(InpShowInflectionLines) {
                ObjectSetInteger(0, objName_Main, OBJPROP_COLOR, clrDarkGray);
                ObjectSetInteger(0, objName_Main, OBJPROP_RAY_RIGHT, false);
                ObjectSetInteger(0, objName_Main, OBJPROP_TIME, 1, mitigatedTime);
            }
            if(InpShowLiquidityLines) {
                ObjectSetInteger(0, objName_Liq, OBJPROP_COLOR, clrDimGray);
                ObjectSetInteger(0, objName_Liq, OBJPROP_RAY_RIGHT, false);
                ObjectSetInteger(0, objName_Liq, OBJPROP_TIME, 1, mitigatedTime);
                ObjectDelete(0, objName_Label); 
            }
        } else {
            if(InpShowInflectionLines) {
                color clr = clrGray;
                if(state == 1) clr = clrLimeGreen;
                else if(state == -1) clr = clrRed;
                ObjectSetInteger(0, objName_Main, OBJPROP_COLOR, clr);
            }
        }
    }

    void UpdateState(double high, double low, double close, datetime currentBarTime, bool isNewBar, double prevClose) {
        if(isMitigated) return;
        double pts = _Point;

        if(!isArmed) {
            if(high >= linePrice + InpArmDistance * pts) {
                isArmed = true; state = 1; UpdateVisuals();
            } else if(low <= linePrice - InpArmDistance * pts) {
                isArmed = true; state = -1; UpdateVisuals();
            }
        }

        if(isArmed) {
            if(isNewBar) {
                if(isPendingFlip) {
                    if(pendingDir == 1 && prevClose < linePrice) {
                        state = -1; isPendingFlip = false; pendingDir = 0; UpdateVisuals();
                    } else if(pendingDir == -1 && prevClose > linePrice) {
                        state = 1; isPendingFlip = false; pendingDir = 0; UpdateVisuals();
                    }
                }
                if(!isPendingFlip) {
                    if(state == -1 && prevClose > linePrice) {
                        isPendingFlip = true; pendingDir = 1; breakoutBar = currentBarTime;
                    } else if(state == 1 && prevClose < linePrice) {
                        isPendingFlip = true; pendingDir = -1; breakoutBar = currentBarTime;
                    }
                }
            }

            if(isPendingFlip) {
                if(pendingDir == 1 && high >= linePrice + InpConfirmDistance * pts) {
                    state = 1; isPendingFlip = false; pendingDir = 0; flipCount++; UpdateVisuals();
                } else if(pendingDir == -1 && low <= linePrice - InpConfirmDistance * pts) {
                    state = -1; isPendingFlip = false; pendingDir = 0; flipCount++; UpdateVisuals();
                }
            }

            if(flipCount >= InpMaxFlips && !isMitigated) {
                isMitigated = true;
                mitigatedTime = currentBarTime + PeriodSeconds(); 
                UpdateVisuals();
            }
        }
    }
};

CArrayObj LinesList;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit() {
    Prefix = "HMAE_" + IntegerToString(ChartID());
    SetChartTheme(InpTheme);
    
    trade.SetExpertMagicNumber(InpMagicNum);
    
    hma_handle = iCustom(_Symbol, _Period, "HMA", InpHMAPeriod, InpPrice, InpColor);
    if(hma_handle == INVALID_HANDLE) {
        Print("Failed to load HMA.mq5.");
        return(INIT_FAILED);
    }
    
    ChartIndicatorAdd(0, 0, hma_handle);
    CleanupObjects();
    LinesList.Clear();
    LinesList.FreeMode(true);
    isHistoricalInit = false; 
    
    return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason) {
    LinesList.Clear();
    CleanupObjects();
    ChartIndicatorDelete(0, 0, "HMA(" + IntegerToString(InpHMAPeriod) + ")");
    IndicatorRelease(hma_handle);
}

void CleanupObjects() {
    int total = ObjectsTotal(0);
    for(int i = total - 1; i >= 0; i--) {
        string name = ObjectName(0, i);
        if(StringFind(name, Prefix) == 0) ObjectDelete(0, name);
    }
}

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick() {
    if(!isHistoricalInit) {
        ProcessHistory(1000); 
        isHistoricalInit = true;
    }

    double h[4], l[4], c[4], o[4];
    datetime t[4];
    if(CopyHigh(_Symbol, _Period, 0, 4, h) < 4) return;
    if(CopyLow(_Symbol, _Period, 0, 4, l) < 4) return;
    if(CopyClose(_Symbol, _Period, 0, 4, c) < 4) return;
    if(CopyOpen(_Symbol, _Period, 0, 4, o) < 4) return;
    if(CopyTime(_Symbol, _Period, 0, 4, t) < 4) return;

    ArraySetAsSeries(h, true);
    ArraySetAsSeries(l, true);
    ArraySetAsSeries(c, true);
    ArraySetAsSeries(o, true);
    ArraySetAsSeries(t, true);

    bool isLiveNewBar = false;
    if(lastProcessedBar != t[0]) {
        isLiveNewBar = true;
        lastProcessedBar = t[0];
    }

    // 1. Manage active trades (Partials, Trailing, DD Entries)
    ManageTrades();

    // 2. Process Entry Signals strictly upon bar close
    if(isLiveNewBar) {
        CheckEntries(h, l, c, o, t);
    }

    // 3. Update internal line states
    for(int k = LinesList.Total() - 1; k >= 0; k--) {
        CInflectionLine* line = LinesList.At(k);
        line.UpdateState(h[0], l[0], c[0], t[0], isLiveNewBar, c[1]);
        if(line.isMitigated && (TimeCurrent() - line.mitigatedTime >= InpCleanupMinutes * 60)) {
            LinesList.Delete(k);
        }
    }

    if(isLiveNewBar) DetectLiveInflection();
}

//+------------------------------------------------------------------+
//| Trade Execution Logic                                            |
//+------------------------------------------------------------------+
void CheckEntries(const double &h[], const double &l[], const double &c[], const double &o[], const datetime &t[]) {
    int total_positions = 0;
    int buys = 0, sells = 0;

    for(int i = PositionsTotal() - 1; i >= 0; i--) {
        if(PositionGetTicket(i)) {
            if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == InpMagicNum) {
                total_positions++;
                if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) buys++;
                else sells++;
            }
        }
    }

    if(total_positions >= InpMaxTradesTotal) return;

    bool buy_signal = false;
    bool sell_signal = false;

    for(int k = 0; k < LinesList.Total(); k++) {
        CInflectionLine* line = LinesList.At(k);
        if(line.isMitigated) continue;

        // Calculate strictly how many bars elapsed since a breakout
        int barsElapsed = 0;
        if(line.isPendingFlip && line.breakoutBar > 0) {
            barsElapsed = (int)((t[1] - line.breakoutBar) / PeriodSeconds()) + 1;
        }

        // BUY SIGNALS (Only on Support lines)
        if(line.state == 1) {
            // Rule 1: Bounce
            // The wick must go below the line, but the candle BODY (Open and Close) must remain above it
            if(InpEnableBounce && l[1] < line.linePrice && MathMin(o[1], c[1]) > line.linePrice) buy_signal = true;
            
            // Rule 2: Fakeout
            // Was pending flip downwards, but reversed to close above strictly within 1-2 candles
            if(InpEnableFakeout && line.isPendingFlip && line.pendingDir == -1 && c[1] > line.linePrice && barsElapsed <= 2) buy_signal = true;
        }

        // SELL SIGNALS (Only on Resistance lines)
        if(line.state == -1) {
            // Rule 1: Bounce
            // The wick must go above the line, but the candle BODY (Open and Close) must remain below it
            if(InpEnableBounce && h[1] > line.linePrice && MathMax(o[1], c[1]) < line.linePrice) sell_signal = true;
            
            // Rule 2: Fakeout
            // Was pending flip upwards, but reversed to close below strictly within 1-2 candles
            if(InpEnableFakeout && line.isPendingFlip && line.pendingDir == 1 && c[1] < line.linePrice && barsElapsed <= 2) sell_signal = true;
        }
    }

    // Only 1 Initial Setup Trade per direction
    if(buy_signal && buys == 0) OpenTrade(POSITION_TYPE_BUY);
    if(sell_signal && sells == 0) OpenTrade(POSITION_TYPE_SELL);
}

void OpenTrade(ENUM_POSITION_TYPE type) {
    double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
    double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
    double sl = 0, tp = 0;

    if(type == POSITION_TYPE_BUY) {
        sl = ask - (InpSL_Points * _Point);
        tp = ask + (InpTP_Points * _Point);
        trade.Buy(InpLotSize, _Symbol, ask, sl, tp);
    } else {
        sl = bid + (InpSL_Points * _Point);
        tp = bid - (InpTP_Points * _Point);
        trade.Sell(InpLotSize, _Symbol, bid, sl, tp);
    }
}

//+------------------------------------------------------------------+
//| Trade Management (Partials, BE, Trailing, DD)                    |
//+------------------------------------------------------------------+
void ManageTrades() {
    CleanTracker();
    
    int total_active = 0;
    int buys = 0, sells = 0;
    double lowest_buy = DBL_MAX, highest_sell = 0;

    for(int i = PositionsTotal() - 1; i >= 0; i--) {
        ulong ticket = PositionGetTicket(i);
        if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagicNum) continue;

        total_active++;
        long type = PositionGetInteger(POSITION_TYPE);
        double open_price = PositionGetDouble(POSITION_PRICE_OPEN);
        double cur_price = PositionGetDouble(POSITION_PRICE_CURRENT);
        double sl = PositionGetDouble(POSITION_SL);
        double tp = PositionGetDouble(POSITION_TP);
        double vol = PositionGetDouble(POSITION_VOLUME);

        if(type == POSITION_TYPE_BUY) {
            buys++;
            if(open_price < lowest_buy) lowest_buy = open_price;
        } else {
            sells++;
            if(open_price > highest_sell) highest_sell = open_price;
        }

        int idx = GetTrackerIndex(ticket);
        if(idx == -1) idx = AddTracker(ticket);

        double profit_points = (type == POSITION_TYPE_BUY) ? (cur_price - open_price) / _Point : (open_price - cur_price) / _Point;

        // 1. Break-Even
        if(profit_points >= InpBE_Points) {
            if(type == POSITION_TYPE_BUY && sl < open_price) trade.PositionModify(ticket, open_price, tp);
            else if(type == POSITION_TYPE_SELL && sl > open_price) trade.PositionModify(ticket, open_price, tp);
        }

        // 2. Partials
        double partial_distance = InpTP_Points / (double)InpPartialsCount;
        int expected_partials = (int)MathFloor(profit_points / partial_distance);

        if(expected_partials > trackerArray[idx].partials_taken && trackerArray[idx].partials_taken < InpPartialsCount) {
            double vol_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
            double close_vol = (InpLotSize * (InpPartialPct / 100.0));
            close_vol = MathFloor(close_vol / vol_step) * vol_step; // Normalize to broker step
            
            if(close_vol < vol_step) close_vol = vol_step;

            if(vol > close_vol) {
                if(trade.PositionClosePartial(ticket, close_vol)) trackerArray[idx].partials_taken++;
            }
        }

        // 3. Trailing Stop & TP Extension
        if(profit_points >= InpTrailTrigger) {
            double new_tp = tp;
            if(!trackerArray[idx].tp_extended) {
                new_tp = (type == POSITION_TYPE_BUY) ? open_price + (InpTrailExtendTP * _Point) : open_price - (InpTrailExtendTP * _Point);
                trackerArray[idx].tp_extended = true;
            }

            double new_sl = sl;
            if(type == POSITION_TYPE_BUY) {
                double prop_sl = cur_price - (InpTrailDistance * _Point);
                if(prop_sl > sl) new_sl = prop_sl;
            } else {
                double prop_sl = cur_price + (InpTrailDistance * _Point);
                if(prop_sl < sl || sl == 0) new_sl = prop_sl;
            }

            if(new_sl != sl || new_tp != tp) trade.PositionModify(ticket, new_sl, new_tp);
        }
    }

    // 4. DD (Drawdown) Entries Stacking
    if(total_active < InpMaxTradesTotal) {
        double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
        double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

        if(buys > 0 && buys <= InpMaxDDEntries) {
            if((lowest_buy - ask) / _Point >= InpDDStepPoints) OpenTrade(POSITION_TYPE_BUY);
        }
        if(sells > 0 && sells <= InpMaxDDEntries) {
            if((bid - highest_sell) / _Point >= InpDDStepPoints) OpenTrade(POSITION_TYPE_SELL);
        }
    }
}

//+------------------------------------------------------------------+
//| Historical processing & Inflection detection                     |
//+------------------------------------------------------------------+
void ProcessHistory(int barsToProcess) {
    MqlRates rates[];
    if(CopyRates(_Symbol, _Period, 0, barsToProcess, rates) < barsToProcess) return;
    ArraySetAsSeries(rates, true);
    double hma[];
    if(CopyBuffer(hma_handle, 0, 0, barsToProcess, hma) < barsToProcess) return;
    ArraySetAsSeries(hma, true);

    for(int i = barsToProcess - 5; i > 0; i--) {
        for(int k = LinesList.Total() - 1; k >= 0; k--) {
            CInflectionLine* line = LinesList.At(k);
            line.UpdateState(rates[i].high, rates[i].low, rates[i].close, rates[i].time, true, rates[i+1].close);
        }
        bool isValley = (hma[i+1] > hma[i+2] && hma[i+2] < hma[i+3]);
        bool isPeak   = (hma[i+1] < hma[i+2] && hma[i+2] > hma[i+3]);
        if(isValley || isPeak) ProcessNewInflection(i, isValley, hma, rates);
    }
}

void DetectLiveInflection() {
    double hma[];
    if(CopyBuffer(hma_handle, 0, 0, 5, hma) < 5) return;
    ArraySetAsSeries(hma, true);
    MqlRates rates[];
    if(CopyRates(_Symbol, _Period, 0, 5, rates) < 5) return;
    ArraySetAsSeries(rates, true);

    bool isValley = (hma[1] > hma[2] && hma[2] < hma[3]);
    bool isPeak   = (hma[1] < hma[2] && hma[2] > hma[3]);
    if(isValley || isPeak) ProcessNewInflection(0, isValley, hma, rates);
}

void ProcessNewInflection(int i, bool isValley, const double &hma[], const MqlRates &rates[]) {
    int dir = isValley ? 1 : -1;
    double rPrice = (InpAnchorType == ANCHOR_HMA_VALUE) ? hma[i+2] : (isValley ? rates[i+2].low : rates[i+2].high);
    double lPrice = rPrice - (dir * InpOffsetPoints * _Point);
    bool canAdd = true;
    for(int k = 0; k < LinesList.Total(); k++) {
        CInflectionLine* l = LinesList.At(k);
        if(l.isMitigated) continue;
        int lDir = (l.state != 0 && l.isArmed) ? l.state : l.originalDir;
        double dist = MathAbs(l.rawPrice - rPrice) / _Point;
        if(lDir == dir) {
            if(dist < InpMergeDistance) { l.isMerged = true; canAdd = false; break; }
            if(dist < InpSameDirDistance) { canAdd = false; break; }
        } else {
            if(dist < InpOppositeDirDistance) { canAdd = false; break; }
        }
    }
    if(canAdd) {
        double lqPrice = (dir == 1) ? GetLowestRates(i+2, InpLiqLookback, rates) : GetHighestRates(i+2, InpLiqLookback, rates);
        CInflectionLine* newLine = new CInflectionLine(Prefix, rates[i+2].time, rPrice, lPrice, dir, lqPrice);
        LinesList.Add(newLine);
    }
}

double GetHighestRates(int startIdx, int count, const MqlRates &rates[]) {
    double maxVal = -DBL_MAX;
    for(int j = 0; j < count; j++) if(startIdx + j < ArraySize(rates) && rates[startIdx + j].high > maxVal) maxVal = rates[startIdx + j].high;
    return maxVal;
}
double GetLowestRates(int startIdx, int count, const MqlRates &rates[]) {
    double minVal = DBL_MAX;
    for(int j = 0; j < count; j++) if(startIdx + j < ArraySize(rates) && rates[startIdx + j].low < minVal) minVal = rates[startIdx + j].low;
    return minVal;
}