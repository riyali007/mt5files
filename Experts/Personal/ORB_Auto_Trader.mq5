#include <Trade\Trade.mqh>

//--- Enums
enum ENUM_CHART_THEME {
    THEME_DARK,       
    THEME_LIGHT       
};

//--- Inputs (Times are calibrated to UTC+2 standard Kill Zones)
input string           InpSettings1           = "--- Asia Session (UTC+2) ---";
input string           InpAsiaStart           = "02:00";          
input string           InpAsiaEnd             = "08:00";          
input string           InpAsiaTradeEnd        = "11:00";          

input string           InpSettings2           = "--- London Session (UTC+2) ---";
input string           InpLonStart            = "09:00";          
input string           InpLonEnd              = "12:00";          
input string           InpLonTradeEnd         = "15:00";          

input string           InpSettings3           = "--- NY AM Session (UTC+2) ---";
input string           InpNYAmStart           = "14:30";          
input string           InpNYAmEnd             = "17:00";          
input string           InpNYAmTradeEnd        = "19:00";          

input string           InpSettings4           = "--- NY PM Session (UTC+2) ---";
input string           InpNYPmStart           = "19:30";          
input string           InpNYPmEnd             = "22:00";          
input string           InpNYPmTradeEnd        = "23:50";          

input string           InpSettings5           = "--- ORB Visuals ---";
input int              InpSpreadPoints        = 50;               // Spread Lines Distance (Points)
input int              InpConfirmDistance     = 400;              // Level Flip Confirmation (Points)

input string           InpSettings6           = "--- FVG Detection ---";
input bool             InpFVG_High            = true;             // Mark FVG on High Breakout
input bool             InpFVG_Mid             = true;             // Mark FVG on Mid Breakout
input bool             InpFVG_Low             = true;             // Mark FVG on Low Breakout

input string           InpSettings7           = "--- Entry Logic ---";
input bool             InpEnableBounce        = true;             // Rule 1: Bounce off Support/Resistance
input bool             InpEnableFakeout       = true;             // Rule 2: Fakeout (Requires 50% Coverage)
input ulong            InpMagicNum            = 888888;           // EA Magic Number

input string           InpSettings8           = "--- Trade Management ---";
input double           InpLotSize             = 0.3;              // Initial Lot Size
input int              InpSL_Points           = 700;              // Stop Loss (Points)
input int              InpTP_Points           = 1400;             // Full Take Profit (Points)
input int              InpPartialsCount       = 7;                // Number of Partials
input double           InpPartialPct          = 10.0;             // % of Lot Size per Partial
input int              InpBE_Points           = 200;              // Points to trigger Break-Even
input int              InpTrailTrigger        = 1000;             // Points to trigger Trailing/TP Extension
input int              InpTrailExtendTP       = 2000;             // Extension Points (Added to Entry)
input int              InpTrailDistance       = 600;              // Trailing Stop Distance
input int              InpMaxTradesTotal      = 4;                // Max simultaneous trades globally
input int              InpMaxDDEntries        = 2;                // Max DD Entries per direction
input int              InpDDStepPoints        = 200;              // Distance between DD entries

input string           InpSettings9           = "--- Visuals & Toggles ---";
input ENUM_CHART_THEME InpTheme               = THEME_DARK;       

//--- Global Variables
string Prefix;
datetime lastProcessedBar = 0;
CTrade trade;

double PendingTriggerSize = 0;
datetime PendingEntryTime = 0;
int lastDayRollover = -1;

//--- Trade Tracker Struct
struct PosTracker {
    ulong ticket;
    int partials_taken;
    bool tp_extended;
    datetime entry_time;
    double trigger_size;
    bool engulfing_checked;
};
PosTracker trackerArray[];

//--- FVG Tracking Struct
struct FVGZone {
    string name;
    double top;
    double bottom;
    datetime startTime;
    bool mitigated;
};
FVGZone fvgArray[];

//+------------------------------------------------------------------+
//| Chart Theme Application                                          |
//+------------------------------------------------------------------+
void SetChartTheme(ENUM_CHART_THEME theme) {
    ChartSetInteger(0, CHART_MODE, CHART_CANDLES);
    ChartSetInteger(0, CHART_SHOW_GRID, true); 
    if(theme == THEME_DARK) {
        ChartSetInteger(0, CHART_COLOR_BACKGROUND, clrBlack);
        ChartSetInteger(0, CHART_COLOR_FOREGROUND, clrSilver);
        ChartSetInteger(0, CHART_COLOR_GRID, (color)0x222222); 
    } else {
        ChartSetInteger(0, CHART_COLOR_BACKGROUND, clrWhite);
        ChartSetInteger(0, CHART_COLOR_FOREGROUND, clrBlack);
        ChartSetInteger(0, CHART_COLOR_GRID, clrLightGray);
    }
    ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| ORB Level & Session Classes                                      |
//+------------------------------------------------------------------+
class CORBLevel {
public:
    string         name;
    double         price;
    int            type;          // 1 = Support, -1 = Resistance
    bool           isPendingFlip;
    int            pendingDir;
    datetime       breakoutBar;
    bool           active;

    void Init(string lvlName, double p, int t) {
        name = lvlName; price = p; type = t;
        isPendingFlip = false; pendingDir = 0; breakoutBar = 0; active = true;
    }

    void UpdateNewBar(double prevC, datetime curBarTime) {
        if(!active) return;
        if(isPendingFlip) {
            if(pendingDir == 1 && prevC < price) { isPendingFlip = false; pendingDir = 0; }
            else if(pendingDir == -1 && prevC > price) { isPendingFlip = false; pendingDir = 0; }
        }
        if(!isPendingFlip) {
            if(type == -1 && prevC > price) { isPendingFlip = true; pendingDir = 1; breakoutBar = curBarTime; }
            else if(type == 1 && prevC < price) { isPendingFlip = true; pendingDir = -1; breakoutBar = curBarTime; }
        }
    }

    void UpdateLive(double h, double l) {
        if(!active || !isPendingFlip) return;
        double pts = _Point;
        if(pendingDir == 1 && h >= price + InpConfirmDistance * pts) { type = 1; isPendingFlip = false; pendingDir = 0; } 
        else if(pendingDir == -1 && l <= price - InpConfirmDistance * pts) { type = -1; isPendingFlip = false; pendingDir = 0; }
    }
};

class CSessionORB {
public:
    string         sessionName;
    string         sStart, sEnd, sTrade;
    datetime       startT, endT, tradeEndT;
    double         sessionHigh, sessionLow;
    bool           isBuilding, isActive, isFinished;
    
    CORBLevel      orbHigh, orbLow, orbMid;

    void Init(string name, string st, string en, string trd) {
        sessionName = name; sStart = st; sEnd = en; sTrade = trd;
        isBuilding = false; isActive = false; isFinished = true;
    }

    void RefreshTimes(datetime current) {
        MqlDateTime dt; TimeToStruct(current, dt);
        startT = StringToTime(StringFormat("%04d.%02d.%02d %s", dt.year, dt.mon, dt.day, sStart));
        endT = StringToTime(StringFormat("%04d.%02d.%02d %s", dt.year, dt.mon, dt.day, sEnd));
        tradeEndT = StringToTime(StringFormat("%04d.%02d.%02d %s", dt.year, dt.mon, dt.day, sTrade));
        
        isBuilding = false; isActive = false; isFinished = false;
        sessionHigh = -DBL_MAX; sessionLow = DBL_MAX;
    }

    void ProcessTick(datetime current, const double &h[], const double &l[], const double &c[], const double &o[], const datetime &t[], bool isNewBar) {
        if(isFinished) return;

        // 1. Building Phase (Kill Zone)
        if(current >= startT && current < endT) {
            if(!isBuilding) { isBuilding = true; isActive = false; }
            if(h[0] > sessionHigh) sessionHigh = h[0];
            if(l[0] < sessionLow) sessionLow = l[0];
            DrawSessionBox(startT, current, sessionHigh, sessionLow);
        }
        // 2. Active Trading Phase (Post-Kill Zone)
        else if(current >= endT && current < tradeEndT) {
            if(isBuilding) {
                isBuilding = false; isActive = true;
                DrawSessionBox(startT, endT, sessionHigh, sessionLow);
                double mid = (sessionHigh + sessionLow) / 2.0;
                
                orbHigh.Init(sessionName+"_High", sessionHigh, -1);
                orbLow.Init(sessionName+"_Low", sessionLow, 1);
                orbMid.Init(sessionName+"_Mid", mid, (SymbolInfoDouble(_Symbol, SYMBOL_BID) > mid) ? 1 : -1);

                DrawTrendLine(Prefix + "_" + sessionName + "_HighLine", endT, tradeEndT, sessionHigh, clrLimeGreen, STYLE_SOLID);
                DrawTrendLine(Prefix + "_" + sessionName + "_LowLine", endT, tradeEndT, sessionLow, clrRed, STYLE_SOLID);
                DrawTrendLine(Prefix + "_" + sessionName + "_MidLine", endT, tradeEndT, mid, clrGray, STYLE_SOLID);
                
                DrawTrendLine(Prefix + "_" + sessionName + "_SpreadH", startT, tradeEndT, sessionHigh + (InpSpreadPoints * _Point), clrDarkOrange, STYLE_DASH);
                DrawTrendLine(Prefix + "_" + sessionName + "_SpreadL", startT, tradeEndT, sessionLow - (InpSpreadPoints * _Point), clrDarkOrange, STYLE_DASH);
            }
            if(isActive) {
                orbHigh.UpdateLive(h[0], l[0]);
                orbLow.UpdateLive(h[0], l[0]);
                orbMid.UpdateLive(h[0], l[0]);
                
                if(isNewBar) {
                    orbHigh.UpdateNewBar(c[1], t[0]);
                    orbLow.UpdateNewBar(c[1], t[0]);
                    orbMid.UpdateNewBar(c[1], t[0]);
                    DetectSessionFVG(h, l, o, c, t);
                }
            }
        }
        // 3. Expiration
        else if(current >= tradeEndT) {
            if(isActive || isBuilding) {
                isActive = false; isBuilding = false; isFinished = true;
                orbHigh.active = false; orbLow.active = false; orbMid.active = false;
            }
        }
    }

    void DrawSessionBox(datetime s, datetime e, double hPrice, double lPrice) {
        string boxName = Prefix + "_" + sessionName + "_KillZone";
        if(ObjectFind(0, boxName) < 0) {
            ObjectCreate(0, boxName, OBJ_RECTANGLE, 0, s, hPrice, e, lPrice);
            ObjectSetInteger(0, boxName, OBJPROP_COLOR, clrDimGray);
            ObjectSetInteger(0, boxName, OBJPROP_BACK, true);
        } else {
            ObjectSetInteger(0, boxName, OBJPROP_TIME, 1, e);
            ObjectSetDouble(0, boxName, OBJPROP_PRICE, 0, hPrice);
            ObjectSetDouble(0, boxName, OBJPROP_PRICE, 1, lPrice);
        }
    }

    void DrawTrendLine(string name, datetime t1, datetime t2, double price, color clr, ENUM_LINE_STYLE style) {
        ObjectCreate(0, name, OBJ_TREND, 0, t1, price, t2, price);
        ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
        ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
        ObjectSetInteger(0, name, OBJPROP_STYLE, style);
        ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
    }

    void DetectSessionFVG(const double &h[], const double &l[], const double &o[], const double &c[], const datetime &t[]) {
        CheckFVGBreakout(orbHigh, InpFVG_High, h, l, o, c, t);
        CheckFVGBreakout(orbLow, InpFVG_Low, h, l, o, c, t);
        CheckFVGBreakout(orbMid, InpFVG_Mid, h, l, o, c, t);
    }

    void CheckFVGBreakout(CORBLevel &lvl, bool enabled, const double &h[], const double &l[], const double &o[], const double &c[], const datetime &t[]) {
        if(!lvl.active || !enabled) return;
        if(MathMin(o[2], c[2]) <= lvl.price && MathMax(o[2], c[2]) >= lvl.price) {
            if(l[1] > h[3] + _Point) CreateFVGObject(h[3], l[1], t[2], clrLimeGreen);
            if(h[1] < l[3] - _Point) CreateFVGObject(h[1], l[3], t[2], clrRed);
        }
    }

    void CreateFVGObject(double bottom, double top, datetime startT, color clr) {
        int s = ArraySize(fvgArray);
        ArrayResize(fvgArray, s + 1);
        fvgArray[s].name = Prefix + "_" + sessionName + "_FVG_" + IntegerToString(s) + "_" + TimeToString(startT);
        fvgArray[s].top = top; fvgArray[s].bottom = bottom; fvgArray[s].startTime = startT; fvgArray[s].mitigated = false;
        
        ObjectCreate(0, fvgArray[s].name, OBJ_RECTANGLE, 0, startT, top, tradeEndT, bottom);
        ObjectSetInteger(0, fvgArray[s].name, OBJPROP_COLOR, clr);
        ObjectSetInteger(0, fvgArray[s].name, OBJPROP_BACK, true);
        ObjectSetInteger(0, fvgArray[s].name, OBJPROP_FILL, true);
    }
};

CSessionORB Sessions[4];

//+------------------------------------------------------------------+
//| Standard Initialization                                          |
//+------------------------------------------------------------------+
int OnInit() {
    Prefix = "ORB_" + IntegerToString(ChartID());
    SetChartTheme(InpTheme);
    trade.SetExpertMagicNumber(InpMagicNum);
    
    Sessions[0].Init("Asia", InpAsiaStart, InpAsiaEnd, InpAsiaTradeEnd);
    Sessions[1].Init("London", InpLonStart, InpLonEnd, InpLonTradeEnd);
    Sessions[2].Init("NY_AM", InpNYAmStart, InpNYAmEnd, InpNYAmTradeEnd);
    Sessions[3].Init("NY_PM", InpNYPmStart, InpNYPmEnd, InpNYPmTradeEnd);

    CleanupObjects();
    ArrayResize(fvgArray, 0);
    return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason) { CleanupObjects(); }
void CleanupObjects() {
    int total = ObjectsTotal(0);
    for(int i = total - 1; i >= 0; i--) {
        string name = ObjectName(0, i);
        if(StringFind(name, Prefix) == 0) ObjectDelete(0, name);
    }
}

//+------------------------------------------------------------------+
//| Core Tick Loop                                                   |
//+------------------------------------------------------------------+
void OnTick() {
    datetime current = TimeCurrent();
    MqlDateTime dt; TimeToStruct(current, dt);
    
    if(dt.day != lastDayRollover) {
        for(int i=0; i<4; i++) Sessions[i].RefreshTimes(current);
        lastDayRollover = dt.day;
    }

    double h[4], l[4], c[4], o[4]; datetime t[4];
    if(CopyHigh(_Symbol, _Period, 0, 4, h) < 4 || CopyLow(_Symbol, _Period, 0, 4, l) < 4 || 
       CopyClose(_Symbol, _Period, 0, 4, c) < 4 || CopyOpen(_Symbol, _Period, 0, 4, o) < 4 || CopyTime(_Symbol, _Period, 0, 4, t) < 4) return;

    ArraySetAsSeries(h, true); ArraySetAsSeries(l, true); ArraySetAsSeries(c, true); ArraySetAsSeries(o, true); ArraySetAsSeries(t, true);
    
    bool isLiveNewBar = (lastProcessedBar != t[0]);
    if(isLiveNewBar) lastProcessedBar = t[0];

    // Process all sessions independently
    for(int i=0; i<4; i++) {
        Sessions[i].ProcessTick(current, h, l, c, o, t, isLiveNewBar);
    }

    // Global Management
    CheckFVGMitigations(h[0], l[0], current);
    ManageTrades(h, l, c, o, t);

    // Global Entries
    if(isLiveNewBar) {
        CheckEntries(h, l, c, o, t);
    }
}

//+------------------------------------------------------------------+
//| FVG Mitigations Globally Managed                                 |
//+------------------------------------------------------------------+
void CheckFVGMitigations(double currentHigh, double currentLow, datetime curTime) {
    for(int i = 0; i < ArraySize(fvgArray); i++) {
        if(!fvgArray[i].mitigated) {
            if(currentLow <= fvgArray[i].top && currentHigh >= fvgArray[i].bottom) {
                fvgArray[i].mitigated = true;
                ObjectSetInteger(0, fvgArray[i].name, OBJPROP_TIME, 1, curTime);
                ObjectSetInteger(0, fvgArray[i].name, OBJPROP_COLOR, clrDarkGray);
            }
        }
    }
}

//+------------------------------------------------------------------+
//| Tracker Array Functions                                          |
//+------------------------------------------------------------------+
int GetTrackerIndex(ulong ticket) {
    for(int i = 0; i < ArraySize(trackerArray); i++) if(trackerArray[i].ticket == ticket) return i;
    return -1;
}

int AddTracker(ulong ticket, datetime entryTime, double trigSize) {
    int size = ArraySize(trackerArray); ArrayResize(trackerArray, size + 1);
    trackerArray[size].ticket = ticket; trackerArray[size].partials_taken = 0; trackerArray[size].tp_extended = false;
    trackerArray[size].entry_time = entryTime; trackerArray[size].trigger_size = trigSize; trackerArray[size].engulfing_checked = false;
    return size;
}

void CleanTracker() {
    for(int i = ArraySize(trackerArray) - 1; i >= 0; i--) if(!PositionSelectByTicket(trackerArray[i].ticket)) ArrayRemove(trackerArray, i, 1);
}

//+------------------------------------------------------------------+
//| Trade Execution Logic (Entry Rules across ALL active sessions)   |
//+------------------------------------------------------------------+
void CheckEntries(const double &h[], const double &l[], const double &c[], const double &o[], const datetime &t[]) {
    int total_positions = 0, buys = 0, sells = 0;
    for(int i = PositionsTotal() - 1; i >= 0; i--) {
        if(PositionGetTicket(i) && PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == InpMagicNum) {
            total_positions++;
            if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) buys++;
            else sells++;
        }
    }

    if(total_positions >= InpMaxTradesTotal) return;

    bool buy_signal = false, sell_signal = false;

    // Scan all active sessions for signals
    for(int s=0; s<4; s++) {
        if(!Sessions[s].isActive) continue;
        
        CORBLevel* levels[3];
        levels[0] = GetPointer(Sessions[s].orbHigh);
        levels[1] = GetPointer(Sessions[s].orbMid);
        levels[2] = GetPointer(Sessions[s].orbLow);

        for(int i = 0; i < 3; i++) {
            if(!levels[i].active) continue;

            int barsElapsed = (levels[i].isPendingFlip && levels[i].breakoutBar > 0) ? (int)((t[1] - levels[i].breakoutBar) / PeriodSeconds()) + 1 : 0;

            // BUY SIGNALS
            if(levels[i].type == 1) {
                if(InpEnableBounce && l[1] < levels[i].price && o[1] > levels[i].price && c[1] > levels[i].price) buy_signal = true;
                if(InpEnableFakeout && levels[i].isPendingFlip && levels[i].pendingDir == -1 && c[1] > levels[i].price && barsElapsed <= 2) {
                    int brkIdx = iBarShift(_Symbol, _Period, levels[i].breakoutBar);
                    if(brkIdx > 0 && (h[1] - l[1]) >= (h[brkIdx] - l[brkIdx]) * 0.50) buy_signal = true;
                }
            }

            // SELL SIGNALS
            if(levels[i].type == -1) {
                if(InpEnableBounce && h[1] > levels[i].price && o[1] < levels[i].price && c[1] < levels[i].price) sell_signal = true;
                if(InpEnableFakeout && levels[i].isPendingFlip && levels[i].pendingDir == 1 && c[1] < levels[i].price && barsElapsed <= 2) {
                    int brkIdx = iBarShift(_Symbol, _Period, levels[i].breakoutBar);
                    if(brkIdx > 0 && (h[1] - l[1]) >= (h[brkIdx] - l[brkIdx]) * 0.50) sell_signal = true;
                }
            }
        }
    }

    if(buy_signal && buys == 0) { PendingEntryTime = t[0]; PendingTriggerSize = h[1] - l[1]; OpenTrade(POSITION_TYPE_BUY); }
    if(sell_signal && sells == 0) { PendingEntryTime = t[0]; PendingTriggerSize = h[1] - l[1]; OpenTrade(POSITION_TYPE_SELL); }
}

void OpenTrade(ENUM_POSITION_TYPE type) {
    double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK), bid = SymbolInfoDouble(_Symbol, SYMBOL_BID), sl = 0, tp = 0;
    if(type == POSITION_TYPE_BUY) { sl = ask - (InpSL_Points * _Point); tp = ask + (InpTP_Points * _Point); trade.Buy(InpLotSize, _Symbol, ask, sl, tp); } 
    else { sl = bid + (InpSL_Points * _Point); tp = bid - (InpTP_Points * _Point); trade.Sell(InpLotSize, _Symbol, bid, sl, tp); }
}

//+------------------------------------------------------------------+
//| Trade Management (Invalidations, BE, Partials, Trail, DD)        |
//+------------------------------------------------------------------+
void ManageTrades(const double &h[], const double &l[], const double &c[], const double &o[], const datetime &t[]) {
    CleanTracker();
    int total_active = 0, buys = 0, sells = 0;
    double lowest_buy = DBL_MAX, highest_sell = 0;

    for(int i = PositionsTotal() - 1; i >= 0; i--) {
        ulong ticket = PositionGetTicket(i);
        if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagicNum) continue;

        total_active++;
        long type = PositionGetInteger(POSITION_TYPE);
        double open_price = PositionGetDouble(POSITION_PRICE_OPEN), cur_price = PositionGetDouble(POSITION_PRICE_CURRENT);
        double sl = PositionGetDouble(POSITION_SL), tp = PositionGetDouble(POSITION_TP), vol = PositionGetDouble(POSITION_VOLUME);

        if(type == POSITION_TYPE_BUY) { buys++; if(open_price < lowest_buy) lowest_buy = open_price; } 
        else { sells++; if(open_price > highest_sell) highest_sell = open_price; }

        int idx = GetTrackerIndex(ticket);
        if(idx == -1) {
            idx = AddTracker(ticket, PendingEntryTime, PendingTriggerSize);
            PendingEntryTime = 0; PendingTriggerSize = 0;
        }

        // --- Invalidation 2: Live Expansion ---
        if(trackerArray[idx].entry_time == t[0] && trackerArray[idx].trigger_size > 0) {
            if((h[0] - l[0]) > trackerArray[idx].trigger_size * 1.05) { trade.PositionClose(ticket); continue; }
        }

        // --- Invalidation 1: ICT Engulfing ---
        if(!trackerArray[idx].engulfing_checked && trackerArray[idx].entry_time > 0 && trackerArray[idx].entry_time < t[0]) {
            int entryIdx = iBarShift(_Symbol, _Period, trackerArray[idx].entry_time);
            if(entryIdx == 1) { 
                bool isBearishEngulfing = (c[1] < o[1] && o[1] >= MathMax(o[2], c[2]) && c[1] <= MathMin(o[2], c[2]));
                bool isBullishEngulfing = (c[1] > o[1] && c[1] >= MathMax(o[2], c[2]) && o[1] <= MathMin(o[2], c[2]));
                if(type == POSITION_TYPE_BUY && isBearishEngulfing) { trade.PositionClose(ticket); continue; }
                if(type == POSITION_TYPE_SELL && isBullishEngulfing) { trade.PositionClose(ticket); continue; }
                trackerArray[idx].engulfing_checked = true;
            } else if (entryIdx > 1) trackerArray[idx].engulfing_checked = true; 
        }

        // --- Standard Trade Management ---
        double profit_points = (type == POSITION_TYPE_BUY) ? (cur_price - open_price) / _Point : (open_price - cur_price) / _Point;

        // Break-Even
        if(profit_points >= InpBE_Points) {
            if(type == POSITION_TYPE_BUY && sl < open_price) trade.PositionModify(ticket, open_price, tp);
            else if(type == POSITION_TYPE_SELL && sl > open_price) trade.PositionModify(ticket, open_price, tp);
        }

        // Partials
        double partial_distance = InpTP_Points / (double)InpPartialsCount;
        if(MathFloor(profit_points / partial_distance) > trackerArray[idx].partials_taken && trackerArray[idx].partials_taken < InpPartialsCount) {
            double vol_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
            double close_vol = MathFloor((InpLotSize * (InpPartialPct / 100.0)) / vol_step) * vol_step; 
            if(close_vol < vol_step) close_vol = vol_step;
            if(vol > close_vol && trade.PositionClosePartial(ticket, close_vol)) trackerArray[idx].partials_taken++;
        }

        // Trailing Stop & TP Extension
        if(profit_points >= InpTrailTrigger) {
            double new_tp = tp;
            if(!trackerArray[idx].tp_extended) {
                new_tp = (type == POSITION_TYPE_BUY) ? open_price + (InpTrailExtendTP * _Point) : open_price - (InpTrailExtendTP * _Point);
                trackerArray[idx].tp_extended = true;
            }
            double new_sl = sl;
            if(type == POSITION_TYPE_BUY) {
                double prop_sl = cur_price - (InpTrailDistance * _Point);
                if(prop_sl > sl) new_sl = prop_sl;
            } else {
                double prop_sl = cur_price + (InpTrailDistance * _Point);
                if(prop_sl < sl || sl == 0) new_sl = prop_sl;
            }
            if(new_sl != sl || new_tp != tp) trade.PositionModify(ticket, new_sl, new_tp);
        }
    }

    // --- DD Entries Stacking ---
    if(total_active < InpMaxTradesTotal) {
        double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK), bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
        if(buys > 0 && buys <= InpMaxDDEntries && (lowest_buy - ask) / _Point >= InpDDStepPoints) OpenTrade(POSITION_TYPE_BUY);
        if(sells > 0 && sells <= InpMaxDDEntries && (bid - highest_sell) / _Point >= InpDDStepPoints) OpenTrade(POSITION_TYPE_SELL);
    }
}